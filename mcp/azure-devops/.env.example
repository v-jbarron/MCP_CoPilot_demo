# Copy this file to .env.local and replace the placeholder values.
# PAT auth is the most predictable option for a headless Docker demo.

ADO_ORG=<your-organization>
ADO_AUTH_MODE=pat
ADO_PAT=
ADO_PAT_EMAIL=demo@example.com
ADO_PROJECT=<your-project>
ADO_TEAM=
ADO_DOMAINS=core work work-items repositories